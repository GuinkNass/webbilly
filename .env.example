# Supabase (Banco de Dados Principal & Fonte Única de Verdade)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Asaas API v3
ASAAS_API_KEY=your_asaas_api_key_here
ASAAS_API_URL=https://api.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=your_asaas_webhook_token_here

# App URL & Autenticação
NEXT_PUBLIC_APP_URL=https://webbilly.com.br
JWT_SECRET=your_jwt_secret_here
ADMIN_EMAILS=admin@billysuite.com.br,lucas@webbilly.com.br

# IA Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Lark Suite SMTP & Roteamento Separado de E-mails
LARK_SMTP_HOST=smtp.larksuite.com
LARK_SMTP_PORT=465
LARK_SMTP_USER=comercial@webbilly.com.br
LARK_SMTP_PASS=your_lark_smtp_password_here
LARK_EMAIL_OPERADORES=operadores@webbilly.com.br
LARK_EMAIL_COMERCIAL=comercial@webbilly.com.br
LARK_EMAIL_DEMO=demo@webbilly.com.br
LARK_EMAIL_SAC=sac@webbilly.com.br
LARK_EMAIL_FINANCEIRO=financeiro@webbilly.com.br
LARK_NOTIFY_EMAIL=comercial@webbilly.com.br

# Vercel API & Domínios Próprios
VERCEL_API_TOKEN=your_vercel_api_token_here
VERCEL_PROJECT_ID=prj_webbilly
